# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/ap_bps

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_super_secret_jwt_key_in_production
JWT_EXPIRES_IN=8h

# ─── Service ports ──────────────────────────────────────────────────────────
API_GATEWAY_PORT=3000
INGESTION_SERVICE_PORT=3001
EXTRACTION_SERVICE_PORT=3002
VALIDATION_SERVICE_PORT=3003
APPROVAL_SERVICE_PORT=3004
ERP_SYNC_SERVICE_PORT=3005
NOTIFICATION_SERVICE_PORT=3006

# ─── AI Providers ────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_GENERATIVE_AI_API_KEY=AIza...
# Default AI provider: openai | anthropic | gemini
DEFAULT_AI_PROVIDER=openai
# OpenAI model
OPENAI_MODEL=gpt-4o
# Anthropic model
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# Gemini model
GEMINI_MODEL=gemini-1.5-pro

# ─── File Storage ────────────────────────────────────────────────────────────
STORAGE_PATH=./uploads
MAX_FILE_SIZE_MB=25
# For PDF invoices, render up to this many pages as images for AI region highlighting (1..10)
PDF_IMAGE_PAGES=1

# ─── Email Intake ────────────────────────────────────────────────────────────
EMAIL_INTAKE_HOST=imap.example.com
EMAIL_INTAKE_PORT=993
EMAIL_INTAKE_USER=ap-invoices@example.com
EMAIL_INTAKE_PASSWORD=your_email_password
EMAIL_INTAKE_POLL_INTERVAL_MS=120000

# ─── Outbound email (notifications) ─────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM="AP System <noreply@example.com>"

# ─── ERP Integration ─────────────────────────────────────────────────────────
# ERP type: sap | oracle | netsuite | dynamics | mock
ERP_TYPE=mock
ERP_API_URL=https://erp.example.com/api
ERP_API_KEY=your_erp_api_key
ERP_SYNC_INTERVAL_MS=3600000

# ─── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000/api
# Ingestion service base URL (for document viewer file access)
NEXT_PUBLIC_INGESTION_URL=http://localhost:3001
