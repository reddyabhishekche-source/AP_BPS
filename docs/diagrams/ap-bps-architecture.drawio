        </mxCell>

        <mxCell id="pq1" value="Redis / BullMQ&#xa;enqueue: invoice-extraction" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#DB2777;fillColor=#FCE7F3;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="370" y="150" width="260" height="70" as="geometry"/>
