        <mxCell id="p2" value="2) Extraction worker&#xa;OCR + AI extraction&#xa;services/extraction-service (:3002)" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#CA8A04;fillColor=#FEF9C3;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="670" y="120" width="280" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="pai" value="AI Providers&#xa;OpenAI / Anthropic / Gemini" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#9A3412;fillColor=#FFF7ED;" vertex="1" parent="1">
          <mxGeometry x="1000" y="120" width="330" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="pdb2" value="PostgreSQL&#xa;Persist extraction output + line items&#xa;Update invoice status" style="shape=cylinder3;whiteSpace=wrap;html=1;strokeColor=#DC2626;fillColor=#FEE2E2;" vertex="1" parent="1">
          <mxGeometry x="670" y="240" width="280" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="pq2" value="Redis / BullMQ&#xa;enqueue: invoice-validation" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#DB2777;fillColor=#FCE7F3;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="370" y="300" width="260" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="p3" value="3) Validation worker&#xa;Business rules&#xa;services/validation-service (:3003)" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#CA8A04;fillColor=#FEF9C3;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="670" y="360" width="280" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="pdb3" value="PostgreSQL&#xa;Update invoice status:&#xa;validated OR verification + exceptions" style="shape=cylinder3;whiteSpace=wrap;html=1;strokeColor=#DC2626;fillColor=#FEE2E2;" vertex="1" parent="1">
          <mxGeometry x="670" y="480" width="280" height="90" as="geometry"/>
        </mxCell>

